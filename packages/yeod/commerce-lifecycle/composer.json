{
  "name": "yeod/commerce-lifecycle",
  "description": "DDD/Onion domain module for order, payment, fulfillment, shipment, returns, catalog availability and archival lifecycles.",
  "type": "library",
  "version": "0.0.0",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^11.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Yeod\\CommerceLifecycle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yeod\\CommerceLifecycle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Yeod\\CommerceLifecycle\\Infrastructure\\Laravel\\CommerceLifecycleServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=512M",
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}