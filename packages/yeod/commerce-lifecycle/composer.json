{
  "name": "yeod/commerce-lifecycle",
  "description": "Status transition graphs for commerce lifecycles plus a guarded Fulfillment aggregate and deep-archive mechanism for Laravel.",
  "type": "library",
  "keywords": [
    "laravel",
    "ddd",
    "onion-architecture",
    "domain",
    "lifecycle",
    "status-machine",
    "fulfillment",
    "archive"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Yevhen Odynets"
    }
  ],
  "support": {
    "issues": "https://github.com/yeod/commerce-lifecycle/issues",
    "source": "https://github.com/yeod/commerce-lifecycle"
  },
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "laravel/pint": "^1.0",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.0|^11.0",
    "phparkitect/phparkitect": "^1.3",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Yeod\\CommerceLifecycle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Yeod\\CommerceLifecycle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Yeod\\CommerceLifecycle\\Infrastructure\\Laravel\\CommerceLifecycleServiceProvider"
      ]
    }
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=512M",
    "arch": "phparkitect check",
    "format": "pint",
    "format:check": "pint --test",
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}